# Template for Android release signing.
#
#   mkdir -p androidApp/keystore
#   cp androidApp/keystore.properties.example androidApp/keystore/keystore.properties
#
# `androidApp/keystore/` is git-ignored, so the copy and the .jks are safe there. This example
# is tracked and the repository is public: never put real values in it.
#
# Create the upload key first (keytool prompts for the passwords and your details):
#
#   keytool -genkeypair -v -keystore androidApp/keystore/starter-release.jks \
#     -keyalg RSA -keysize 4096 -validity 10000 -alias starter
#
# Back the .jks up. With Play App Signing it is only the upload key and Google can reset it;
# without Play App Signing, losing it means the listing can never be updated.
#
# Absolute path; a relative one resolves against the Gradle module, not your shell.
storeFile=/Users/you/starter/androidApp/keystore/starter-release.jks
storePassword=
keyAlias=starter
keyPassword=
